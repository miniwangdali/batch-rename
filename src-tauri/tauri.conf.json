{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Batch Rename",
  "mainBinaryName": "batch-rename",
  "version": "../package.json",
  "identifier": "io.github.miniwangdali.batch-rename",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Batch Rename",
        "width": 1100,
        "height": 700,
        "minWidth": 760,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost",
      "devCsp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "deb", "rpm", "appimage"],
    "category": "Utility",
    "shortDescription": "Batch rename files and folders",
    "longDescription": "A tiny batch file renamer inspired by PowerToys PowerRename: search and replace with regular expressions, counters, dates and live preview.",
    "copyright": "Copyright (c) Xiaoyan Wang. MIT License.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
